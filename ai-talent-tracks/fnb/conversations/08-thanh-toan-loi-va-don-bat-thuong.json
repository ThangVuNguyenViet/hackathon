{
  "schemaVersion": "kfc-outcome-scenario-v2",
  "id": "08-thanh-toan-loi-va-don-bat-thuong",
  "title": "08: Lỗi thanh toán và đơn bất thường",
  "channel": "kfc",
  "goal": "Không nhận thanh toán thất bại là thành công và chuyển đơn số lượng bất thường cho người hỗ trợ.",
  "useCases": ["UC-18", "UC-38", "UC-39"],
  "finalState": "human_review_required",
  "setup": {"requiresCustomerAccess": true, "seedPendingPayment": true},
  "turns": [
    {
      "index": 1, "speaker": "User", "text": "Mình thanh toán rồi mà báo lỗi.", "useCases": ["UC-18"],
      "outcome": {
        "state": {
          "mustChange": ["paymentAttempt"],
          "mustNotChange": ["cart", "order"],
          "facts": [{"source": "state", "path": "paymentAttempt.status", "operator": "equals", "value": "failed"}]
        },
        "effects": {"required": ["payment_changed"], "forbidden": ["cart_mutated", "order_created"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["paymentOrderStatus", "supportHandoff"], "requiredDataPaths": ["data"]}},
        "provenance": {"requiredEvidenceKinds": ["payment_status"]},
        "latency": {"maxTurnMs": 5000}
      }
    },
    {
      "index": 3, "speaker": "User", "text": "Mình bấm thanh toán mà lỗi hoài.", "useCases": ["UC-18"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "order"],
          "facts": [{"source": "state", "path": "paymentAttempt.status", "operator": "equals", "value": "failed"}]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["paymentOrderStatus", "supportHandoff"], "requiredDataPaths": ["data"]}},
        "provenance": {"requiredEvidenceKinds": ["payment_status"]},
        "latency": {"maxTurnMs": 5000}
      }
    },
    {
      "index": 5, "speaker": "User", "text": "Giờ cao điểm mà mình muốn đặt 200 combo gà, giao trong 30 phút.", "useCases": ["UC-38", "UC-39"],
      "outcome": {
        "state": {
          "mustChange": ["handoff"],
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "presentation", "path": "handoff.reasons", "operator": "set_equals", "value": ["payment_failed", "abnormal_large_order", "human_review_required"]}
          ]
        },
        "effects": {"required": ["handoff_created"], "forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["supportHandoff"], "requiredDataPaths": ["data.handoff"]}}
      }
    },
    {
      "index": 7, "speaker": "User", "text": "Sao phải chuyển nhân viên?", "useCases": ["Filler"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "handoff", "order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "handoff.escalationId", "operator": "present"},
            {"source": "presentation", "path": "handoff.active", "operator": "equals", "value": true}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"allowedWidgetKinds": ["supportHandoff", "paymentOrderStatus"]}}
      }
    }
  ]
}
