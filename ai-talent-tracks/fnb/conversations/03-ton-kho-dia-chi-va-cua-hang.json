{
  "schemaVersion": "kfc-outcome-scenario-v2",
  "id": "03-ton-kho-dia-chi-va-cua-hang",
  "title": "03: Tồn kho, nhận tại cửa hàng rồi chuyển sang giao hàng",
  "channel": "kfc",
  "goal": "Kiểm tra tồn kho, chọn nhận tại cửa hàng, đổi sang giao tới địa chỉ đã lưu và lấy báo giá giao hàng.",
  "useCases": ["UC-06", "UC-07", "UC-08", "UC-37"],
  "finalState": "delivery_quoted",
  "setup": {"requiresCustomerAccess": true},
  "turns": [
    {
      "index": 1,
      "speaker": "User",
      "text": "Burger Tôm còn ở KFC Đường Huỳnh Tấn Phát 2, Nhà Bè không? Mình ở Cần Giờ; cửa hàng đó có giao tới đây không? Nếu không thì mình sẽ tới nhận.",
      "useCases": ["UC-06", "UC-08"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "fulfillment", "order", "paymentAttempt"],
          "facts": [
            {"source": "presentation", "path": "availability.itemCode", "operator": "equals", "value": "41140"},
            {"source": "presentation", "path": "availability.available", "operator": "equals", "value": false},
            {"source": "presentation", "path": "fulfillment.deliverable", "operator": "equals", "value": false},
            {"source": "presentation", "path": "pickup.storeId", "operator": "equals", "value": "KFCVN0219"}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "fulfillment_changed", "order_created", "payment_changed"]},
        "presentation": {
          "genUi": {"required": true, "allowedWidgetKinds": ["smartMenuPicker", "addressFulfillmentCheck"], "requiredDataPaths": ["data.items"]},
          "collections": [{"key": "menu:burger-tom", "scope": "filtered", "minItems": 1}]
        },
        "provenance": {"requiredEvidenceKinds": ["catalog", "store_availability"]}
      }
    },
    {
      "index": 3,
      "speaker": "User",
      "text": "Vậy lấy 1 Burger Gà Zinger và tìm cửa hàng gần nhất còn món quanh Nhà Bè cho mình.",
      "useCases": ["UC-37"],
      "outcome": {
        "state": {
          "mustChange": ["cart"],
          "mustNotChange": ["fulfillment", "order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "cart.items", "operator": "contains", "value": [{"itemCode": "41141", "quantity": 1, "unitPriceVnd": 56000}]},
            {"source": "presentation", "path": "availability.itemCode", "operator": "equals", "value": "41141"},
            {"source": "presentation", "path": "availability.available", "operator": "equals", "value": true},
            {"source": "presentation", "path": "pickup.storeId", "operator": "equals", "value": "KFCVN0219"}
          ]
        },
        "effects": {"required": ["cart_mutated"], "forbidden": ["fulfillment_changed", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["cartBuilder", "addressFulfillmentCheck"], "requiredDataPaths": ["data"]}},
        "provenance": {"requiredEvidenceKinds": ["catalog", "store_availability"]}
      }
    },
    {
      "index": 5,
      "speaker": "User",
      "text": "Chọn cửa hàng đó, mình sẽ tới nhận.",
      "useCases": ["Filler"],
      "outcome": {
        "state": {
          "mustChange": ["fulfillment"],
          "mustNotChange": ["address", "cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "fulfillment.method", "operator": "equals", "value": "pickup"},
            {"source": "state", "path": "fulfillment.storeId", "operator": "equals", "value": "KFCVN0219"},
            {"source": "presentation", "path": "pickup.feeVnd", "operator": "absent"},
            {"source": "presentation", "path": "pickup.etaMinutes", "operator": "absent"}
          ]
        },
        "effects": {"required": ["fulfillment_changed"], "forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["addressFulfillmentCheck"], "requiredDataPaths": ["data.fulfillment"]}},
        "provenance": {"requiredEvidenceKinds": ["store_availability"]}
      }
    },
    {
      "index": 7,
      "speaker": "User",
      "text": "Đổi sang giao tới địa chỉ đã lưu của mình nhé.",
      "useCases": ["UC-07"],
      "outcome": {
        "state": {
          "mustNotChange": ["address", "fulfillment", "cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "presentation", "path": "savedAddress.candidateIndex", "operator": "equals", "value": 0},
            {"source": "presentation", "path": "savedAddress.confirmationRequired", "operator": "equals", "value": true}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "fulfillment_changed", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["addressFulfillmentCheck"], "requiredDataPaths": ["data.addressStatus"]}},
        "provenance": {"requiredEvidenceKinds": ["customer_address"]}
      }
    },
    {
      "index": 9,
      "speaker": "User",
      "text": "Đúng, giao tới địa chỉ 123 Nguyễn Trãi, Quận 5 đã lưu.",
      "useCases": ["Filler"],
      "outcome": {
        "state": {
          "mustChange": ["address", "fulfillment"],
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "address.line1", "operator": "equals", "value": "123 Nguyễn Trãi"},
            {"source": "state", "path": "address.district", "operator": "equals", "value": "Quận 5"},
            {"source": "state", "path": "address.city", "operator": "equals", "value": "Hồ Chí Minh"},
            {"source": "state", "path": "fulfillment.method", "operator": "equals", "value": "delivery"},
            {"source": "state", "path": "fulfillment.feeVnd", "operator": "equals", "value": 18000},
            {"source": "state", "path": "fulfillment.etaMinutes", "operator": "equals", "value": 35}
          ]
        },
        "effects": {"required": ["fulfillment_changed"], "forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["addressFulfillmentCheck"], "requiredDataPaths": ["data.fulfillment"]}},
        "provenance": {"requiredEvidenceKinds": ["customer_address", "fulfillment_quote"]}
      }
    }
  ]
}
