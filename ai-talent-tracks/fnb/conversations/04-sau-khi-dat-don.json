{
  "schemaVersion": "kfc-outcome-scenario-v2",
  "id": "04-sau-khi-dat-don",
  "title": "04: Theo dõi, hủy, đặt lại và chỉnh đơn sau khi đặt",
  "channel": "messenger_mock",
  "goal": "Theo dõi đơn đã trả tiền, không sửa/hủy thiếu xác nhận và tạo giỏ mới khi đặt lại.",
  "useCases": ["UC-20", "UC-21", "UC-22", "UC-23", "UC-26"],
  "finalState": "post_order_handled",
  "setup": {"requiresCustomerAccess": true, "seedPaidOrder": true},
  "turns": [
    {
      "index": 1, "speaker": "User", "text": "Đơn của mình tới đâu rồi?", "useCases": ["UC-21"],
      "outcome": {
        "state": {"mustNotChange": ["cart", "order", "paymentAttempt"], "facts": [{"source": "state", "path": "order.id", "operator": "equals", "value": "KFC-1024"}, {"source": "state", "path": "order.status", "operator": "equals", "value": "preparing"}]},
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["orderTrackingStatus"], "requiredDataPaths": ["data.order"]}},
        "provenance": {"requiredEvidenceKinds": ["order_status"]},
        "latency": {"maxTurnMs": 5000}
      }
    },
    {
      "index": 3, "speaker": "User", "text": "Bao lâu nữa giao tới?", "useCases": ["UC-21"],
      "outcome": {
        "state": {"mustNotChange": ["cart", "order", "paymentAttempt"], "facts": [{"source": "state", "path": "order.id", "operator": "equals", "value": "KFC-1024"}]},
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["orderTrackingStatus"], "requiredDataPaths": ["data.order"]}},
        "provenance": {"requiredEvidenceKinds": ["order_status"]},
        "latency": {"maxTurnMs": 5000}
      }
    },
    {
      "index": 5, "speaker": "User", "text": "Đơn đang chuẩn bị rồi thì mình đổi địa chỉ nhận được không?", "useCases": ["UC-23"],
      "outcome": {
        "state": {"mustNotChange": ["cart", "address", "fulfillment", "order", "paymentAttempt"], "facts": [{"source": "state", "path": "order.id", "operator": "equals", "value": "KFC-1024"}, {"source": "state", "path": "order.status", "operator": "equals", "value": "preparing"}]},
        "effects": {"forbidden": ["cart_mutated", "fulfillment_changed", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["orderTrackingStatus"], "requiredDataPaths": ["data.order"]}},
        "provenance": {"requiredEvidenceKinds": ["order_status"]},
        "latency": {"maxTurnMs": 5000}
      }
    },
    {
      "index": 7, "speaker": "User", "text": "Mình thêm 1 khoai nữa được không?", "useCases": ["UC-26"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [{"source": "presentation", "path": "fulfillment.postOrderItemAddAllowed", "operator": "equals", "value": false}]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "provenance": {"requiredEvidenceKinds": ["order_status"]}
      }
    },
    {
      "index": 9, "speaker": "User", "text": "Mình muốn hủy đơn vừa đặt.", "useCases": ["UC-20"],
      "outcome": {
        "state": {
          "mustChange": ["cancellationStatusChecked"],
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [{"source": "state", "path": "cancellationStatusChecked", "operator": "equals", "value": true}]
        },
        "effects": {"required": ["approval_requested"], "forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "provenance": {"requiredEvidenceKinds": ["order_status"]}
      }
    },
    {
      "index": 11, "speaker": "User", "text": "Nếu đơn đã chuẩn bị hoặc đang giao rồi thì sao, mình vẫn muốn hủy.", "useCases": ["UC-20"],
      "outcome": {
        "state": {"mustChange": ["handoff"], "mustNotChange": ["cart", "order", "paymentAttempt"]},
        "effects": {"required": ["handoff_created"], "forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["supportHandoff", "orderTrackingStatus"], "requiredDataPaths": ["data"]}},
        "provenance": {"requiredEvidenceKinds": ["order_status"]}
      }
    },
    {
      "index": 13, "speaker": "User", "text": "Chưa hủy, cho mình đặt lại đơn lần trước cho đồng nghiệp.", "useCases": ["UC-22"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [{"source": "presentation", "path": "reorder.confirmationRequired", "operator": "equals", "value": true}]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "provenance": {"requiredEvidenceKinds": ["order_history"]}
      }
    },
    {
      "index": 15, "speaker": "User", "text": "Đúng rồi, nhưng đơn hiện tại cứ giữ nguyên.", "useCases": ["Filler"],
      "outcome": {
        "state": {
          "mustChange": ["cart"],
          "mustNotChange": ["order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "order.id", "operator": "equals", "value": "KFC-1024"},
            {"source": "state", "path": "cart.items.*.itemCode", "operator": "set_equals", "value": ["41141"]},
            {"source": "state", "path": "cart.items", "operator": "contains", "value": [{"itemCode": "41141", "quantity": 1, "unitPriceVnd": 56000}]},
            {"source": "state", "path": "cart.totalVnd", "operator": "equals", "value": 56000}
          ]
        },
        "effects": {"required": ["cart_mutated"], "forbidden": ["order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["cartBuilder"], "requiredDataPaths": ["data.cart"]}},
        "provenance": {"requiredEvidenceKinds": ["order_history", "catalog"]}
      }
    }
  ]
}
