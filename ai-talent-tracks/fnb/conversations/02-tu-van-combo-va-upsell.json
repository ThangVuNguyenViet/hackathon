{
  "schemaVersion": "kfc-outcome-scenario-v2",
  "id": "02-tu-van-combo-va-upsell",
  "title": "02: Toàn bộ menu, tư vấn đồ uống, combo và upsize",
  "channel": "zalo_mock",
  "goal": "Hiển thị trọn menu, tư vấn đồ uống và tối ưu giỏ theo combo/upsize chỉ sau khi khách chấp nhận.",
  "useCases": ["UC-01", "UC-02", "UC-03", "UC-04", "UC-09", "UC-10", "UC-11", "UC-12", "UC-13"],
  "finalState": "cart_ready",
  "setup": {},
  "turns": [
    {
      "index": 1,
      "speaker": "User",
      "text": "Cho mình xem toàn bộ menu hiện có.",
      "useCases": ["UC-04"],
      "outcome": {
        "state": {"mustNotChange": ["cart", "order", "paymentAttempt"]},
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {
          "genUi": {"required": true, "allowedWidgetKinds": ["smartMenuPicker"], "requiredDataPaths": ["data.items", "data.categories", "data.total", "data.returned", "data.complete", "data.selectionLimit"]},
          "collections": [{"key": "menu:all", "scope": "all", "minItems": 1, "exactVerifiedItems": true, "requireComplete": true, "requireCategoryTabs": true, "selectionLimit": 5}]
        },
        "provenance": {"requiredEvidenceKinds": ["catalog"]}
      }
    },
    {
      "index": 3,
      "speaker": "User",
      "text": "Mình muốn gọi thêm đồ uống cho nhóm, bạn gợi ý vài lựa chọn phù hợp nhé.",
      "useCases": ["UC-11", "UC-12"],
      "outcome": {
        "state": {"mustNotChange": ["cart", "order", "paymentAttempt"]},
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {
          "genUi": {"required": true, "allowedWidgetKinds": ["smartMenuPicker"], "requiredDataPaths": ["data.items"]},
          "collections": [{"key": "menu:drinks", "scope": "filtered", "minItems": 1, "maxItems": 3, "requiredCategories": ["Thức Uống & Tráng Miệng"]}]
        },
        "provenance": {"requiredEvidenceKinds": ["catalog"]}
      }
    },
    {
      "index": 5,
      "speaker": "User",
      "text": "Không biết ăn gì, gợi ý cho nhóm 4 người với, ngân sách khoảng 300k.",
      "useCases": ["UC-02", "UC-03", "UC-11", "UC-13"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "presentation", "path": "recommendation.partySize", "operator": "equals", "value": 4},
            {"source": "presentation", "path": "recommendation.servings", "operator": "gte", "value": 4},
            {"source": "presentation", "path": "recommendation.totalVnd", "operator": "lte", "value": 300000}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {
          "genUi": {"required": true, "allowedWidgetKinds": ["smartMenuPicker"], "requiredDataPaths": ["data.items"]},
          "collections": [{"key": "menu:group-four", "scope": "filtered", "minItems": 1, "maxItems": 3}]
        },
        "provenance": {"requiredEvidenceKinds": ["catalog"]}
      }
    },
    {
      "index": 7,
      "speaker": "User",
      "text": "Không cần thêm món tráng miệng. Hôm nay có ưu đãi gì phù hợp không?",
      "useCases": ["UC-04", "UC-09"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [{"source": "presentation", "path": "promotion.offerIds", "operator": "present"}]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["promotionGallery"], "requiredDataPaths": ["data.promotions"]}},
        "provenance": {"requiredEvidenceKinds": ["promotion"]}
      }
    },
    {
      "index": 9,
      "speaker": "User",
      "text": "Nếu gọi lẻ thì cho mình 4 miếng gà rán, 2 Burger Gà Yo, 2 khoai vừa và 4 Pepsi vừa.",
      "useCases": ["UC-01"],
      "outcome": {
        "state": {
          "mustChange": ["cart"],
          "mustNotChange": ["order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "cart.items.*.itemCode", "operator": "set_equals", "value": ["41036", "41042", "41063", "41075"]},
            {"source": "state", "path": "cart.items", "operator": "contains", "value": [{"itemCode": "41036", "quantity": 2}, {"itemCode": "41042", "quantity": 2}, {"itemCode": "41063", "quantity": 2}, {"itemCode": "41075", "quantity": 4}]},
            {"source": "state", "path": "cart.totalVnd", "operator": "equals", "value": 316000}
          ]
        },
        "effects": {"required": ["cart_mutated"], "forbidden": ["order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["cartBuilder", "smartMenuPicker"], "requiredDataPaths": ["data"]}},
        "provenance": {"requiredEvidenceKinds": ["catalog"]}
      }
    },
    {
      "index": 11,
      "speaker": "User",
      "text": "Hợp lý đó, đổi sang 2 Combo Burger Gà Yo & Gà Rán giúp mình.",
      "useCases": ["UC-10"],
      "outcome": {
        "state": {
          "mustChange": ["cart"],
          "mustNotChange": ["order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "cart.items.*.itemCode", "operator": "set_equals", "value": ["20702"]},
            {"source": "state", "path": "cart.items", "operator": "contains", "value": [{"itemCode": "20702", "quantity": 2}]},
            {"source": "state", "path": "cart.totalVnd", "operator": "equals", "value": 258000}
          ]
        },
        "effects": {"required": ["cart_mutated"], "forbidden": ["order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["cartBuilder", "modifierPicker"], "requiredDataPaths": ["data"]}},
        "provenance": {"requiredEvidenceKinds": ["catalog"]}
      }
    },
    {
      "index": 13,
      "speaker": "User",
      "text": "Ok, nâng cả 4 Pepsi lên size đại luôn nhé.",
      "useCases": ["UC-10"],
      "outcome": {
        "state": {
          "mustChange": ["cart"],
          "mustNotChange": ["order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "cart.items.*.itemCode", "operator": "set_equals", "value": ["20702"]},
            {"source": "state", "path": "cart.items", "operator": "contains", "value": [{"itemCode": "20702", "quantity": 2, "unitPriceVnd": 135000, "modifiers": [{"groupId": "4", "modifierId": "41091", "quantity": 1, "priceDeltaVnd": 3000}, {"groupId": "5", "modifierId": "41091", "quantity": 1, "priceDeltaVnd": 3000}]}]},
            {"source": "state", "path": "cart.totalVnd", "operator": "equals", "value": 270000}
          ]
        },
        "effects": {"required": ["cart_mutated"], "forbidden": ["order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["cartBuilder"], "requiredDataPaths": ["data.cart"]}},
        "provenance": {"requiredEvidenceKinds": ["catalog"]}
      }
    }
  ]
}
