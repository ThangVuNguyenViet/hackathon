{
  "schemaVersion": "kfc-outcome-scenario-v2",
  "id": "05-khieu-nai-va-human-handoff",
  "title": "05: Khiếu nại, feedback và chuyển nhân viên",
  "channel": "zalo_mock",
  "goal": "Ghi nhận khiếu nại mà không tạo giao dịch và chuyển nhân viên khi khách yêu cầu.",
  "useCases": ["UC-27", "UC-28", "UC-29", "UC-30"],
  "finalState": "human_handoff_created",
  "setup": {},
  "turns": [
    {
      "index": 1, "speaker": "User", "text": "Mình nhận thiếu 1 phần khoai.", "useCases": ["UC-27"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "presentation", "path": "complaint.category", "operator": "equals", "value": "missing_item"},
            {"source": "presentation", "path": "complaint.recorded", "operator": "equals", "value": true}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]}
      }
    },
    {
      "index": 3, "speaker": "User", "text": "Với lại mình đặt gà cay mà giao gà thường.", "useCases": ["UC-27"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "presentation", "path": "complaint.category", "operator": "equals", "value": "wrong_item"},
            {"source": "presentation", "path": "complaint.recorded", "operator": "equals", "value": true}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]}
      }
    },
    {
      "index": 5, "speaker": "User", "text": "Đơn gì mà lâu quá vậy, bực mình thật.", "useCases": ["UC-29"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "presentation", "path": "complaint.category", "operator": "equals", "value": "late_delivery"},
            {"source": "presentation", "path": "complaint.priority", "operator": "equals", "value": "high"},
            {"source": "presentation", "path": "complaint.recorded", "operator": "equals", "value": true}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]}
      }
    },
    {
      "index": 7, "speaker": "User", "text": "Cho mình gặp nhân viên.", "useCases": ["UC-30"],
      "outcome": {
        "state": {
          "mustChange": ["handoff"],
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "presentation", "path": "handoff.reasons", "operator": "set_equals", "value": ["missing_item", "wrong_item", "late_delivery", "angry_customer", "human_requested"]}
          ]
        },
        "effects": {"required": ["handoff_created"], "forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["supportHandoff"], "requiredDataPaths": ["data.handoff"]}}
      }
    },
    {
      "index": 9, "speaker": "User", "text": "Nhưng gà ngon, chỉ là giao hơi lâu và sai món.", "useCases": ["UC-28"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "handoff", "order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "handoff.escalationId", "operator": "present"},
            {"source": "presentation", "path": "feedback.recorded", "operator": "equals", "value": true},
            {"source": "presentation", "path": "complaint.categories", "operator": "set_equals", "value": ["missing_item", "wrong_item", "late_delivery"]}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]}
      }
    }
  ]
}
