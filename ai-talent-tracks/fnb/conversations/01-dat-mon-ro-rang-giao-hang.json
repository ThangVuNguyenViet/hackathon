{
  "schemaVersion": "kfc-outcome-scenario-v2",
  "id": "01-dat-mon-ro-rang-giao-hang",
  "title": "01: Đặt món rõ ràng, giao hàng, voucher, thanh toán",
  "channel": "messenger_mock",
  "goal": "Đặt đúng món, báo phí giao, áp voucher, lưu hóa đơn và chỉ tạo đơn sau xác nhận.",
  "useCases": ["UC-01", "UC-07", "UC-16", "UC-17", "UC-19", "UC-24", "UC-25"],
  "finalState": "order_created",
  "setup": {},
  "turns": [
    {
      "index": 1,
      "speaker": "User",
      "text": "Cho mình 1 Combo Burger Gà Yo & Gà Rán, chọn phần gà Giòn Cay; thêm 1 Burger Gà Zinger và 2 Pepsi, giao về Quận 7.",
      "useCases": ["UC-01", "UC-07"],
      "outcome": {
        "state": {
          "mustChange": ["cart"],
          "mustNotChange": ["order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "cart.items.*.itemCode", "operator": "set_equals", "value": ["20702", "41141", "41074"]},
            {"source": "state", "path": "cart.items", "operator": "contains", "value": [{"itemCode": "20702", "quantity": 1, "modifiers": [{"groupId": "60254", "modifierId": "70012", "quantity": 2}]}, {"itemCode": "41141", "quantity": 1}, {"itemCode": "41074", "quantity": 2}]},
            {"source": "state", "path": "cart.subtotalVnd", "operator": "equals", "value": 211000}
          ]
        },
        "effects": {"required": ["cart_mutated"], "forbidden": ["order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["cartBuilder"], "requiredDataPaths": ["data.cart"]}},
        "provenance": {"requiredEvidenceKinds": ["catalog"]}
      }
    },
    {
      "index": 3,
      "speaker": "User",
      "text": "Chung cư Sunrise City, 23 Nguyễn Hữu Thọ, phường Tân Hưng. Phí ship bao nhiêu?",
      "useCases": ["UC-24"],
      "outcome": {
        "state": {
          "mustChange": ["address", "fulfillment"],
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "address.district", "operator": "equals", "value": "Quận 7"},
            {"source": "state", "path": "fulfillment.feeVnd", "operator": "equals", "value": 18000}
          ]
        },
        "effects": {"required": ["fulfillment_changed"], "forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["addressFulfillmentCheck"], "requiredDataPaths": ["data.fulfillment"]}},
        "provenance": {"requiredEvidenceKinds": ["fulfillment_quote"]}
      }
    },
    {
      "index": 5,
      "speaker": "User",
      "text": "Mình có mã KFC50, áp dụng giúp mình.",
      "useCases": ["UC-17"],
      "outcome": {
        "state": {
          "mustChange": ["cart", "promotionContext"],
          "mustNotChange": ["order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "cart.voucherCode", "operator": "equals", "value": "KFC50"},
            {"source": "state", "path": "cart.discountVnd", "operator": "equals", "value": 50000},
            {"source": "state", "path": "cart.totalVnd", "operator": "equals", "value": 179000},
            {"source": "presentation", "path": "promotion.minimumOrderVnd", "operator": "equals", "value": 195000}
          ]
        },
        "effects": {"forbidden": ["order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["promotionGallery", "orderReviewConfirm"], "requiredDataPaths": ["data"]}},
        "provenance": {"requiredEvidenceKinds": ["promotion"]}
      }
    },
    {
      "index": 7,
      "speaker": "User",
      "text": "Thanh toán bằng ZaloPay được không?",
      "useCases": ["UC-16"],
      "outcome": {
        "state": {
          "mustChange": ["paymentMethodEvidence"],
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "paymentMethodEvidence", "operator": "present"},
            {"source": "presentation", "path": "paymentMethods.methodId", "operator": "equals", "value": "zalopay_wallet"},
            {"source": "presentation", "path": "paymentMethods.supported", "operator": "equals", "value": true}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["paymentMethodPicker"], "requiredDataPaths": ["data.methods"]}},
        "provenance": {"requiredEvidenceKinds": ["payment_policy"], "requireOfficialSameReference": true}
      }
    },
    {
      "index": 9,
      "speaker": "User",
      "text": "Giao tới nơi gọi mình, đừng bấm chuông. Mình cần xuất hóa đơn công ty nữa.",
      "useCases": ["UC-19", "UC-25"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "presentation", "path": "orderNotes.callOnArrival", "operator": "equals", "value": true},
            {"source": "presentation", "path": "orderNotes.ringDoorbell", "operator": "equals", "value": false},
            {"source": "presentation", "path": "invoice.requested", "operator": "equals", "value": true}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"allowedWidgetKinds": ["orderReviewConfirm"]}}
      }
    },
    {
      "index": 11,
      "speaker": "User",
      "text": "Công ty ABC, MST 0312345678, email finance@abc.test. Xác nhận đơn.",
      "useCases": ["UC-19"],
      "outcome": {
        "state": {
          "mustChange": ["invoiceRequest", "order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "invoiceRequest.companyName", "operator": "equals", "value": "Công ty ABC"},
            {"source": "state", "path": "invoiceRequest.taxCode", "operator": "equals", "value": "0312345678"},
            {"source": "state", "path": "invoiceRequest.email", "operator": "equals", "value": "finance@abc.test"},
            {"source": "state", "path": "order.id", "operator": "present"},
            {"source": "state", "path": "order.status", "operator": "equals", "value": "created"},
            {"source": "state", "path": "order.paymentStatus", "operator": "equals", "value": "pending"},
            {"source": "state", "path": "order.assignedStoreId", "operator": "present"},
            {"source": "state", "path": "paymentAttempt.status", "operator": "equals", "value": "pending"},
            {"source": "state", "path": "paymentAttempt.paymentUrl", "operator": "present"},
            {"source": "presentation", "path": "orderNotes.callOnArrival", "operator": "equals", "value": true},
            {"source": "presentation", "path": "orderNotes.ringDoorbell", "operator": "equals", "value": false},
            {"source": "presentation", "path": "invoice.requested", "operator": "equals", "value": true}
          ]
        },
        "effects": {"required": ["order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["orderReviewConfirm", "paymentOrderStatus"], "requiredDataPaths": ["data"]}},
        "provenance": {"requiredEvidenceKinds": ["order_receipt", "payment_receipt"]}
      }
    }
  ]
}
