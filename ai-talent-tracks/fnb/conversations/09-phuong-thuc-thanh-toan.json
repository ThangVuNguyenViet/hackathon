{
  "schemaVersion": "kfc-outcome-scenario-v2",
  "id": "09-phuong-thuc-thanh-toan",
  "title": "09: Phương thức thanh toán website/app",
  "channel": "kfc",
  "goal": "Trả lời phương thức thanh toán chỉ từ chính sách chính thức đã xác minh và không tạo giao dịch.",
  "useCases": ["UC-16"],
  "finalState": "payment_methods_answered",
  "setup": {},
  "turns": [
    {
      "index": 1, "speaker": "User", "text": "KFC có những phương thức thanh toán nào trên website/app?", "useCases": ["UC-16"],
      "outcome": {
        "state": {
          "mustChange": ["paymentMethodEvidence"],
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "paymentMethodEvidence", "operator": "present"},
            {"source": "presentation", "path": "paymentMethods.supportedIds", "operator": "set_equals", "value": ["cash_on_delivery", "atm_internet_banking", "visa_master_card", "zalopay_wallet"]},
            {"source": "presentation", "path": "paymentMethods.unsupportedIds", "operator": "set_equals", "value": ["momo_wallet"]}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["paymentMethodPicker"], "requiredDataPaths": ["data.methods"], "forbiddenActions": ["widget:paymentOrderStatus"]}},
        "provenance": {"requiredEvidenceKinds": ["payment_policy"], "requireOfficialSameReference": true}
      }
    },
    {
      "index": 3, "speaker": "User", "text": "Vậy thanh toán MoMo được không?", "useCases": ["UC-16"],
      "outcome": {
        "state": {
          "mustNotChange": ["cart", "order", "paymentAttempt"],
          "facts": [
            {"source": "state", "path": "paymentMethodEvidence", "operator": "present"},
            {"source": "presentation", "path": "paymentMethods.methodId", "operator": "equals", "value": "momo_wallet"},
            {"source": "presentation", "path": "paymentMethods.supported", "operator": "equals", "value": false}
          ]
        },
        "effects": {"forbidden": ["cart_mutated", "order_created", "payment_changed"]},
        "presentation": {"genUi": {"required": true, "allowedWidgetKinds": ["paymentMethodPicker"], "requiredDataPaths": ["data.methods"], "forbiddenActions": ["widget:paymentOrderStatus"]}},
        "provenance": {"requiredEvidenceKinds": ["payment_policy"], "requireOfficialSameReference": true}
      }
    }
  ]
}
