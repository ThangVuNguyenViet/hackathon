{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfc.local/contracts/recommendations/v1/kfc-recommendation.schema.json",
  "title": "KFC Recommendation v1",
  "oneOf": [
    { "$ref": "#/$defs/RecommendationDecisionRequest" },
    { "$ref": "#/$defs/RecommendationDecisionResponse" },
    { "$ref": "#/$defs/RecommendationEvent" },
    { "$ref": "#/$defs/RecommendationState" },
    { "$ref": "#/$defs/RecommendationImpressionRequest" },
    { "$ref": "#/$defs/RecommendationOutcomeRequest" }
  ],
  "$defs": {
    "OpaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "integer", "minimum": 0 },
        "currency": { "const": "VND" }
      }
    },
    "SnapshotProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reference"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "SanitySnapshotBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "digest", "contributingRevisions"],
      "properties": {
        "snapshotId": { "$ref": "#/$defs/OpaqueId" },
        "digest": { "$ref": "#/$defs/Sha256" },
        "contributingRevisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "SnapshotBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "digest",
        "sourceRevision",
        "observedAt",
        "effectiveAt",
        "expiresAt",
        "complete",
        "commerceEnvironment",
        "provenance"
      ],
      "properties": {
        "snapshotId": { "$ref": "#/$defs/OpaqueId" },
        "digest": { "$ref": "#/$defs/Sha256" },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "observedAt": { "$ref": "#/$defs/Instant" },
        "effectiveAt": { "$ref": "#/$defs/Instant" },
        "expiresAt": { "$ref": "#/$defs/Instant" },
        "complete": { "type": "boolean" },
        "commerceEnvironment": { "$ref": "#/$defs/OpaqueId" },
        "provenance": { "$ref": "#/$defs/SnapshotProvenance" }
      }
    },
    "CommerceSnapshotBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "modifierGraph",
        "store",
        "availability",
        "promotion"
      ],
      "properties": {
        "catalog": { "$ref": "#/$defs/SnapshotBinding" },
        "modifierGraph": { "$ref": "#/$defs/SnapshotBinding" },
        "store": { "$ref": "#/$defs/SnapshotBinding" },
        "availability": { "$ref": "#/$defs/SnapshotBinding" },
        "promotion": { "$ref": "#/$defs/SnapshotBinding" }
      }
    },
    "ModifierSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupPath", "optionId", "quantity", "priceImpact"],
      "properties": {
        "groupPath": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OpaqueId" }
        },
        "optionId": { "$ref": "#/$defs/OpaqueId" },
        "quantity": { "type": "integer", "minimum": 1 },
        "priceImpact": { "$ref": "#/$defs/Money" }
      }
    },
    "CartLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineId",
        "sellableItemId",
        "quantity",
        "unitPrice",
        "modifiers"
      ],
      "properties": {
        "lineId": { "$ref": "#/$defs/OpaqueId" },
        "sellableItemId": { "$ref": "#/$defs/OpaqueId" },
        "quantity": { "type": "integer", "minimum": 1 },
        "unitPrice": { "$ref": "#/$defs/Money" },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/ModifierSelection" }
        }
      }
    },
    "CartSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cartId", "revision", "subtotal", "lines"],
      "properties": {
        "cartId": { "$ref": "#/$defs/OpaqueId" },
        "revision": { "$ref": "#/$defs/OpaqueId" },
        "subtotal": { "$ref": "#/$defs/Money" },
        "lines": {
          "type": "array",
          "items": { "$ref": "#/$defs/CartLine" }
        }
      }
    },
    "ExperimentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "outputMode"],
      "properties": {
        "profileId": { "$ref": "#/$defs/OpaqueId" },
        "outputMode": { "enum": ["baseline", "learned_technical"] }
      }
    },
    "Placement": {
      "enum": [
        "local_favorite",
        "for_you",
        "modifier_upsell",
        "smart_cross_sell"
      ]
    },
    "DecisionStatus": {
      "enum": [
        "recommended",
        "empty",
        "suppressed",
        "invalid_context",
        "ineligible_context"
      ]
    },
    "DecisionSource": {
      "enum": ["ranked", "merchandising_replacement", "fallback", "suppressed"]
    },
    "RecommendationDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "idempotencyKey",
        "orderFlowId",
        "sessionId",
        "placement",
        "verifiedCustomerRef",
        "storeId",
        "fulfilmentMode",
        "decisionTime",
        "cart",
        "cartRevision",
        "commerceSnapshotBindings",
        "eligibilityPolicyVersion",
        "experimentProfile"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-recommendation-v1" },
        "requestId": { "$ref": "#/$defs/OpaqueId" },
        "idempotencyKey": { "$ref": "#/$defs/OpaqueId" },
        "orderFlowId": { "$ref": "#/$defs/OpaqueId" },
        "sessionId": { "$ref": "#/$defs/OpaqueId" },
        "placement": { "$ref": "#/$defs/Placement" },
        "verifiedCustomerRef": {
          "anyOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        },
        "storeId": { "$ref": "#/$defs/OpaqueId" },
        "fulfilmentMode": { "enum": ["pickup", "delivery"] },
        "decisionTime": { "$ref": "#/$defs/Instant" },
        "cart": { "$ref": "#/$defs/CartSnapshot" },
        "cartRevision": { "$ref": "#/$defs/OpaqueId" },
        "commerceSnapshotBindings": {
          "$ref": "#/$defs/CommerceSnapshotBindings"
        },
        "eligibilityPolicyVersion": {
          "const": "kfc-recommendation-policy-v1"
        },
        "experimentProfile": { "$ref": "#/$defs/ExperimentProfile" }
      }
    },
    "AddProductAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "actionId",
        "sellableItemId",
        "quantity",
        "priceImpact",
        "cartRevision"
      ],
      "properties": {
        "type": { "const": "add_product" },
        "actionId": { "$ref": "#/$defs/OpaqueId" },
        "sellableItemId": { "$ref": "#/$defs/OpaqueId" },
        "quantity": { "type": "integer", "minimum": 1 },
        "priceImpact": { "$ref": "#/$defs/Money" },
        "cartRevision": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "ApplyModifierAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "actionId",
        "parentCartLineId",
        "parentSellableItemId",
        "optionId",
        "groupPath",
        "quantity",
        "priceImpact",
        "cartRevision"
      ],
      "properties": {
        "type": { "const": "apply_modifier" },
        "actionId": { "$ref": "#/$defs/OpaqueId" },
        "parentCartLineId": { "$ref": "#/$defs/OpaqueId" },
        "parentSellableItemId": { "$ref": "#/$defs/OpaqueId" },
        "optionId": { "$ref": "#/$defs/OpaqueId" },
        "groupPath": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OpaqueId" }
        },
        "quantity": { "type": "integer", "minimum": 1 },
        "priceImpact": { "$ref": "#/$defs/Money" },
        "cartRevision": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "ReplaceCartLineAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "actionId",
        "replacedCartLineId",
        "replacement",
        "priceImpact",
        "cartRevision"
      ],
      "properties": {
        "type": { "const": "replace_cart_line" },
        "actionId": { "$ref": "#/$defs/OpaqueId" },
        "replacedCartLineId": { "$ref": "#/$defs/OpaqueId" },
        "replacement": { "$ref": "#/$defs/AddProductAction" },
        "priceImpact": { "$ref": "#/$defs/Money" },
        "cartRevision": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "RecommendationAction": {
      "oneOf": [
        { "$ref": "#/$defs/AddProductAction" },
        { "$ref": "#/$defs/ApplyModifierAction" },
        { "$ref": "#/$defs/ReplaceCartLineAction" }
      ]
    },
    "PrimaryOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/RecommendationAction" }
        }
      }
    },
    "DisplayFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "name", "imageUrl", "priceImpact"],
      "properties": {
        "actionId": { "$ref": "#/$defs/OpaqueId" },
        "name": { "type": "string" },
        "imageUrl": { "type": ["string", "null"] },
        "priceImpact": { "$ref": "#/$defs/Money" }
      }
    },
    "CustomerReasonCode": {
      "enum": [
        "popular_here",
        "ordered_before",
        "matches_your_history",
        "completes_your_item",
        "completes_your_meal",
        "active_offer",
        "merchandising_selection"
      ]
    },
    "MerchandisingAction": {
      "enum": [
        "exclude_target",
        "boost_target",
        "pin_target",
        "replace_slate",
        "suppress_placement"
      ]
    },
    "MerchandisingEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "action", "targetActionId", "detail"],
      "properties": {
        "policyId": { "$ref": "#/$defs/OpaqueId" },
        "action": { "$ref": "#/$defs/MerchandisingAction" },
        "targetActionId": {
          "anyOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "VersionBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "modifierGraph",
        "store",
        "availability",
        "promotion",
        "eligibilityPolicy",
        "sanitySnapshot",
        "featureSchema",
        "servingRanker",
        "shadowModel",
        "calibration",
        "experiment",
        "loggingPolicy"
      ],
      "properties": {
        "catalog": { "$ref": "#/$defs/OpaqueId" },
        "modifierGraph": { "$ref": "#/$defs/OpaqueId" },
        "store": { "$ref": "#/$defs/OpaqueId" },
        "availability": { "$ref": "#/$defs/OpaqueId" },
        "promotion": { "$ref": "#/$defs/OpaqueId" },
        "eligibilityPolicy": { "$ref": "#/$defs/OpaqueId" },
        "sanitySnapshot": { "$ref": "#/$defs/SanitySnapshotBinding" },
        "featureSchema": { "$ref": "#/$defs/OpaqueId" },
        "servingRanker": { "$ref": "#/$defs/OpaqueId" },
        "shadowModel": {
          "anyOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        },
        "calibration": {
          "anyOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        },
        "experiment": { "$ref": "#/$defs/OpaqueId" },
        "loggingPolicy": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "RecommendationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "potential",
        "eligible",
        "ineligible",
        "scored",
        "displayed",
        "complete"
      ],
      "properties": {
        "potential": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 },
        "ineligible": { "type": "integer", "minimum": 0 },
        "scored": { "type": "integer", "minimum": 0 },
        "displayed": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" }
      }
    },
    "RecommendationDecisionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recommendationId",
        "requestId",
        "orderFlowId",
        "placement",
        "status",
        "decisionSource",
        "primaryOffer",
        "displayFacts",
        "reasonCodes",
        "merchandisingEffects",
        "versionBindings",
        "counts",
        "traceRef"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-recommendation-v1" },
        "recommendationId": { "$ref": "#/$defs/OpaqueId" },
        "requestId": { "$ref": "#/$defs/OpaqueId" },
        "orderFlowId": { "$ref": "#/$defs/OpaqueId" },
        "placement": { "$ref": "#/$defs/Placement" },
        "status": { "$ref": "#/$defs/DecisionStatus" },
        "decisionSource": { "$ref": "#/$defs/DecisionSource" },
        "primaryOffer": {
          "anyOf": [{ "$ref": "#/$defs/PrimaryOffer" }, { "type": "null" }]
        },
        "displayFacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/DisplayFact" }
        },
        "reasonCodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/CustomerReasonCode" }
        },
        "merchandisingEffects": {
          "type": "array",
          "items": { "$ref": "#/$defs/MerchandisingEffect" }
        },
        "versionBindings": { "$ref": "#/$defs/VersionBindings" },
        "counts": { "$ref": "#/$defs/RecommendationCounts" },
        "traceRef": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "RecommendationStage": {
      "enum": [
        "starter_eligible",
        "starter_resolved",
        "modifier_eligible",
        "modifier_pending",
        "modifier_resolved",
        "smart_cross_sell_eligible",
        "smart_cross_sell_pending",
        "complete"
      ]
    },
    "NextEligiblePlacement": {
      "enum": ["starter", "modifier_upsell", "smart_cross_sell", null]
    },
    "PendingRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendationId",
        "requestId",
        "placement",
        "actionIds",
        "cartRevision",
        "traceRef",
        "decidedAt"
      ],
      "properties": {
        "recommendationId": { "$ref": "#/$defs/OpaqueId" },
        "requestId": { "$ref": "#/$defs/OpaqueId" },
        "placement": { "$ref": "#/$defs/Placement" },
        "actionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/OpaqueId" }
        },
        "cartRevision": { "$ref": "#/$defs/OpaqueId" },
        "traceRef": { "$ref": "#/$defs/OpaqueId" },
        "decidedAt": { "$ref": "#/$defs/Instant" }
      }
    },
    "RecommendationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "revision",
        "orderFlowId",
        "stage",
        "attemptedPlacements",
        "shownActionIds",
        "rejectedActionIds",
        "pendingRecommendation",
        "recordedOutcomeEventIds",
        "nextEligiblePlacement"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-recommendation-state-v1" },
        "revision": { "type": "integer", "minimum": 0 },
        "orderFlowId": { "$ref": "#/$defs/OpaqueId" },
        "stage": { "$ref": "#/$defs/RecommendationStage" },
        "attemptedPlacements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Placement" }
        },
        "shownActionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/OpaqueId" }
        },
        "rejectedActionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/OpaqueId" }
        },
        "pendingRecommendation": {
          "anyOf": [
            { "$ref": "#/$defs/PendingRecommendation" },
            { "type": "null" }
          ]
        },
        "recordedOutcomeEventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/OpaqueId" }
        },
        "nextEligiblePlacement": { "$ref": "#/$defs/NextEligiblePlacement" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "stage": { "const": "starter_eligible" } } },
          "then": {
            "type": "object",
            "properties": {
              "nextEligiblePlacement": { "const": "starter" },
              "pendingRecommendation": { "type": "null" }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "stage": { "const": "starter_resolved" } } },
          "then": {
            "type": "object",
            "properties": {
              "nextEligiblePlacement": { "type": "null" },
              "pendingRecommendation": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "allOf": [
                      { "$ref": "#/$defs/PendingRecommendation" },
                      {
                        "type": "object",
                        "properties": {
                          "placement": { "enum": ["local_favorite", "for_you"] }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "stage": { "const": "modifier_eligible" } } },
          "then": {
            "type": "object",
            "properties": {
              "nextEligiblePlacement": { "const": "modifier_upsell" },
              "pendingRecommendation": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "allOf": [
                      { "$ref": "#/$defs/PendingRecommendation" },
                      {
                        "type": "object",
                        "properties": {
                          "placement": { "enum": ["local_favorite", "for_you"] }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "stage": { "const": "modifier_pending" } } },
          "then": {
            "type": "object",
            "properties": {
              "nextEligiblePlacement": { "type": "null" },
              "pendingRecommendation": {
                "allOf": [
                  { "$ref": "#/$defs/PendingRecommendation" },
                  { "type": "object", "properties": { "placement": { "const": "modifier_upsell" } } }
                ]
              }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "stage": { "const": "modifier_resolved" } } },
          "then": {
            "type": "object",
            "properties": {
              "nextEligiblePlacement": { "const": "smart_cross_sell" },
              "pendingRecommendation": { "type": "null" }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "stage": { "const": "smart_cross_sell_eligible" } } },
          "then": {
            "type": "object",
            "properties": {
              "nextEligiblePlacement": { "const": "smart_cross_sell" },
              "pendingRecommendation": { "type": "null" }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "stage": { "const": "smart_cross_sell_pending" } } },
          "then": {
            "type": "object",
            "properties": {
              "nextEligiblePlacement": { "type": "null" },
              "pendingRecommendation": {
                "allOf": [
                  { "$ref": "#/$defs/PendingRecommendation" },
                  { "type": "object", "properties": { "placement": { "const": "smart_cross_sell" } } }
                ]
              }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "stage": { "const": "complete" } } },
          "then": {
            "type": "object",
            "properties": {
              "nextEligiblePlacement": { "type": "null" },
              "pendingRecommendation": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["pendingRecommendation"],
            "properties": {
              "pendingRecommendation": {
                "type": "object",
                "required": ["placement"],
                "properties": { "placement": { "const": "local_favorite" } }
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "attemptedPlacements": {
                "type": "array",
                "contains": { "const": "local_favorite" }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["pendingRecommendation"],
            "properties": {
              "pendingRecommendation": {
                "type": "object",
                "required": ["placement"],
                "properties": { "placement": { "const": "for_you" } }
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "attemptedPlacements": {
                "type": "array",
                "contains": { "const": "for_you" }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["pendingRecommendation"],
            "properties": {
              "pendingRecommendation": {
                "type": "object",
                "required": ["placement"],
                "properties": { "placement": { "const": "modifier_upsell" } }
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "attemptedPlacements": {
                "type": "array",
                "contains": { "const": "modifier_upsell" }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["pendingRecommendation"],
            "properties": {
              "pendingRecommendation": {
                "type": "object",
                "required": ["placement"],
                "properties": { "placement": { "const": "smart_cross_sell" } }
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "attemptedPlacements": {
                "type": "array",
                "contains": { "const": "smart_cross_sell" }
              }
            }
          }
        }
      ]
    },
    "RenderedRecommendationAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "position"],
      "properties": {
        "actionId": { "$ref": "#/$defs/OpaqueId" },
        "position": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "RecommendationImpressionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "occurredAt",
        "assistantTurnId",
        "attachmentId",
        "renderedActions",
        "cartRevision",
        "actionDigest"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-recommendation-event-v1" },
        "eventId": { "$ref": "#/$defs/OpaqueId" },
        "occurredAt": { "$ref": "#/$defs/Instant" },
        "assistantTurnId": { "$ref": "#/$defs/OpaqueId" },
        "attachmentId": { "$ref": "#/$defs/OpaqueId" },
        "renderedActions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "$comment": "Draft 2020-12 cannot enforce uniqueness of arbitrary actionId properties across array objects; Zod and Pydantic enforce it.",
          "items": { "$ref": "#/$defs/RenderedRecommendationAction" },
          "allOf": [
            {
              "contains": { "type": "object", "properties": { "position": { "const": 1 } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "type": "object", "properties": { "position": { "const": 2 } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "type": "object", "properties": { "position": { "const": 3 } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "type": "object", "properties": { "position": { "const": 4 } } },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        },
        "cartRevision": { "$ref": "#/$defs/OpaqueId" },
        "actionDigest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "RecommendationOutcomeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "eventType",
        "occurredAt",
        "actor",
        "actionId",
        "cartRevision",
        "payload"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-recommendation-event-v1" },
        "eventId": { "$ref": "#/$defs/OpaqueId" },
        "eventType": {
          "enum": [
            "selected",
            "explicitly_dismissed",
            "ignored",
            "superseded",
            "cart_mutation_succeeded",
            "cart_mutation_failed",
            "checkout_completed",
            "order_abandoned",
            "order_cancelled"
          ]
        },
        "occurredAt": { "$ref": "#/$defs/Instant" },
        "actor": { "$ref": "#/$defs/EventActor" },
        "actionId": {
          "anyOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        },
        "cartRevision": {
          "anyOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            ".*": { "$ref": "#/$defs/JsonValue" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "eventType": {
                "enum": [
                  "selected",
                  "cart_mutation_succeeded",
                  "cart_mutation_failed"
                ]
              }
            }
          },
          "then": { "type": "object", "properties": { "actionId": { "$ref": "#/$defs/OpaqueId" } } }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "eventType": {
                "enum": ["checkout_completed", "order_abandoned", "order_cancelled"]
              }
            }
          },
          "then": { "type": "object", "properties": { "actionId": { "type": "null" } } }
        }
      ]
    },
    "EventType": {
      "enum": [
        "decision_requested",
        "decision_completed",
        "candidate_eligibility_summary",
        "impression_rendered",
        "selected",
        "explicitly_dismissed",
        "ignored",
        "superseded",
        "cart_mutation_succeeded",
        "cart_mutation_failed",
        "checkout_completed",
        "order_abandoned",
        "order_cancelled"
      ]
    },
    "EventActor": {
      "enum": ["customer", "agent", "system", "client"]
    },
    "JsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/JsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            ".*": { "$ref": "#/$defs/JsonValue" }
          }
        }
      ]
    },
    "RecommendationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "eventType",
        "recommendationId",
        "requestId",
        "orderFlowId",
        "sessionId",
        "placement",
        "occurredAt",
        "recordedAt",
        "actor",
        "actionId",
        "cartRevision",
        "versionBindings",
        "payload"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-recommendation-event-v1" },
        "eventId": { "$ref": "#/$defs/OpaqueId" },
        "eventType": { "$ref": "#/$defs/EventType" },
        "recommendationId": {
          "anyOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        },
        "requestId": { "$ref": "#/$defs/OpaqueId" },
        "orderFlowId": { "$ref": "#/$defs/OpaqueId" },
        "sessionId": { "$ref": "#/$defs/OpaqueId" },
        "placement": { "$ref": "#/$defs/Placement" },
        "occurredAt": { "$ref": "#/$defs/Instant" },
        "recordedAt": { "$ref": "#/$defs/Instant" },
        "actor": { "$ref": "#/$defs/EventActor" },
        "actionId": {
          "anyOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        },
        "cartRevision": {
          "anyOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        },
        "versionBindings": { "$ref": "#/$defs/VersionBindings" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            ".*": { "$ref": "#/$defs/JsonValue" }
          }
        }
      }
    }
  }
}
