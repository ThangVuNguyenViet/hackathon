{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kfc.invalid/automatic-recommendations/v1/automatic-recommendation.schema.json",
  "title": "KFC Automatic Recommendation Wire Contract",
  "$defs": {
    "OpaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "integer", "minimum": 0 },
        "currency": { "const": "VND" }
      }
    },
    "ModifierSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupPath", "optionId", "quantity", "priceImpact"],
      "properties": {
        "groupPath": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OpaqueId" }
        },
        "optionId": { "$ref": "#/$defs/OpaqueId" },
        "quantity": { "type": "integer", "minimum": 1 },
        "priceImpact": { "$ref": "#/$defs/Money" }
      }
    },
    "CartLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineId",
        "sellableItemId",
        "quantity",
        "unitPrice",
        "modifiers"
      ],
      "properties": {
        "lineId": { "$ref": "#/$defs/OpaqueId" },
        "sellableItemId": { "$ref": "#/$defs/OpaqueId" },
        "quantity": { "type": "integer", "minimum": 1 },
        "unitPrice": { "$ref": "#/$defs/Money" },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/ModifierSelection" }
        }
      }
    },
    "Cart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cartId", "revision", "subtotal", "lines"],
      "properties": {
        "cartId": { "$ref": "#/$defs/OpaqueId" },
        "revision": { "$ref": "#/$defs/OpaqueId" },
        "subtotal": { "$ref": "#/$defs/Money" },
        "lines": {
          "type": "array",
          "items": { "$ref": "#/$defs/CartLine" }
        }
      }
    },
    "NonEmptyCart": {
      "allOf": [
        { "$ref": "#/$defs/Cart" },
        {
          "type": "object",
          "properties": { "lines": { "type": "array", "minItems": 1 } }
        }
      ]
    },
    "LocalFavoriteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "storeId",
        "fulfilmentMode",
        "locale",
        "orderingJourneyRef",
        "opportunityRef",
        "cart"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-automatic-recommendation-v1" },
        "requestId": { "$ref": "#/$defs/OpaqueId", "description": "Globally unique. Identical canonical content replays the stored decision; changed content or a different type conflicts." },
        "storeId": { "$ref": "#/$defs/OpaqueId" },
        "fulfilmentMode": { "enum": ["pickup", "delivery"] },
        "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "orderingJourneyRef": { "$ref": "#/$defs/OpaqueId" },
        "opportunityRef": { "$ref": "#/$defs/OpaqueId" },
        "cart": { "$ref": "#/$defs/Cart" }
      }
    },
    "ForYouRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "storeId",
        "fulfilmentMode",
        "locale",
        "orderingJourneyRef",
        "opportunityRef",
        "cart",
        "verifiedCustomerRef"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-automatic-recommendation-v1" },
        "requestId": { "$ref": "#/$defs/OpaqueId", "description": "Globally unique. Identical canonical content replays the stored decision; changed content or a different type conflicts." },
        "storeId": { "$ref": "#/$defs/OpaqueId" },
        "fulfilmentMode": { "enum": ["pickup", "delivery"] },
        "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "orderingJourneyRef": { "$ref": "#/$defs/OpaqueId" },
        "opportunityRef": { "$ref": "#/$defs/OpaqueId" },
        "cart": { "$ref": "#/$defs/Cart" },
        "verifiedCustomerRef": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "ModifierUpsellRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "storeId",
        "fulfilmentMode",
        "locale",
        "orderingJourneyRef",
        "opportunityRef",
        "cart",
        "parentCartLineId"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-automatic-recommendation-v1" },
        "requestId": { "$ref": "#/$defs/OpaqueId", "description": "Globally unique. Identical canonical content replays the stored decision; changed content or a different type conflicts." },
        "storeId": { "$ref": "#/$defs/OpaqueId" },
        "fulfilmentMode": { "enum": ["pickup", "delivery"] },
        "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "orderingJourneyRef": { "$ref": "#/$defs/OpaqueId" },
        "opportunityRef": { "$ref": "#/$defs/OpaqueId" },
        "cart": { "$ref": "#/$defs/Cart" },
        "parentCartLineId": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "SmartCrossSellRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "storeId",
        "fulfilmentMode",
        "locale",
        "orderingJourneyRef",
        "opportunityRef",
        "cart"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-automatic-recommendation-v1" },
        "requestId": { "$ref": "#/$defs/OpaqueId", "description": "Globally unique. Identical canonical content replays the stored decision; changed content or a different type conflicts." },
        "storeId": { "$ref": "#/$defs/OpaqueId" },
        "fulfilmentMode": { "enum": ["pickup", "delivery"] },
        "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "orderingJourneyRef": { "$ref": "#/$defs/OpaqueId" },
        "opportunityRef": { "$ref": "#/$defs/OpaqueId" },
        "cart": { "$ref": "#/$defs/NonEmptyCart" }
      }
    },
    "ModelBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "bundleDigest",
        "modelRevision",
        "calibratorRevision",
        "featureSchemaDigest",
        "thresholdRevision",
        "composerContractDigest",
        "qualificationRunId",
        "qualificationEvidenceDigest"
      ],
      "properties": {
        "bundleId": { "$ref": "#/$defs/OpaqueId" },
        "bundleDigest": { "$ref": "#/$defs/Sha256" },
        "modelRevision": { "$ref": "#/$defs/OpaqueId" },
        "calibratorRevision": { "$ref": "#/$defs/OpaqueId" },
        "featureSchemaDigest": { "$ref": "#/$defs/Sha256" },
        "thresholdRevision": { "$ref": "#/$defs/OpaqueId" },
        "composerContractDigest": { "$ref": "#/$defs/Sha256" },
        "qualificationRunId": { "$ref": "#/$defs/OpaqueId" },
        "qualificationEvidenceDigest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ProductAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sellableItemId", "quantity", "priceImpact"],
      "properties": {
        "type": { "const": "add_product" },
        "sellableItemId": { "$ref": "#/$defs/OpaqueId" },
        "quantity": { "type": "integer", "minimum": 1 },
        "priceImpact": { "$ref": "#/$defs/Money" }
      }
    },
    "ModifierAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "parentCartLineId",
        "parentSellableItemId",
        "optionId",
        "groupPath",
        "quantity",
        "priceImpact"
      ],
      "properties": {
        "type": { "const": "apply_modifier" },
        "parentCartLineId": { "$ref": "#/$defs/OpaqueId" },
        "parentSellableItemId": { "$ref": "#/$defs/OpaqueId" },
        "optionId": { "$ref": "#/$defs/OpaqueId" },
        "groupPath": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OpaqueId" }
        },
        "quantity": { "type": "integer", "minimum": 1 },
        "priceImpact": { "$ref": "#/$defs/Money" }
      }
    },
    "Proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "action", "display", "reasonCodes"],
      "properties": {
        "actionId": { "$ref": "#/$defs/OpaqueId" },
        "action": {
          "oneOf": [
            { "$ref": "#/$defs/ProductAction" },
            { "$ref": "#/$defs/ModifierAction" }
          ]
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "imageUrl", "priceImpact"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "imageUrl": { "type": ["string", "null"], "format": "uri" },
            "priceImpact": { "$ref": "#/$defs/Money" }
          }
        },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "popular_here",
              "ordered_before",
              "matches_your_history",
              "completes_your_item",
              "completes_your_meal",
              "active_offer"
            ]
          }
        }
      }
    },
    "RecommendationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "recommendationId",
        "recommendationType",
        "status",
        "emptyReason",
        "cartRevision",
        "catalogRevision",
        "expiresAt",
        "model",
        "proposals",
        "counts"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-automatic-recommendation-v1" },
        "requestId": { "$ref": "#/$defs/OpaqueId" },
        "recommendationId": { "$ref": "#/$defs/OpaqueId" },
        "recommendationType": {
          "enum": [
            "local_favorite",
            "for_you",
            "modifier_upsell",
            "smart_cross_sell"
          ]
        },
        "status": { "enum": ["recommended", "empty", "paused"] },
        "emptyReason": {
          "type": ["string", "null"],
          "enum": [
            null,
            "no_qualified_model",
            "no_eligible_candidates",
            "insufficient_history",
            "parent_cart_line_not_found",
            "empty_cart",
            "no_candidate_above_threshold",
            "recommendation_serving_paused"
          ]
        },
        "cartRevision": { "$ref": "#/$defs/OpaqueId" },
        "catalogRevision": { "$ref": "#/$defs/OpaqueId" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "model": {
          "oneOf": [
            { "$ref": "#/$defs/ModelBinding" },
            { "type": "null" }
          ]
        },
        "proposals": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/Proposal" }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["potential", "eligible", "scored", "displayed"],
          "properties": {
            "potential": { "type": "integer", "minimum": 0 },
            "eligible": { "type": "integer", "minimum": 0 },
            "scored": { "type": "integer", "minimum": 0 },
            "displayed": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "status": { "const": "recommended" },
                "emptyReason": { "type": "null" },
                "model": { "$ref": "#/$defs/ModelBinding" },
                "proposals": { "type": "array", "minItems": 1 }
              }
            },
            {
              "properties": {
                "status": { "const": "empty" },
                "emptyReason": { "enum": ["no_qualified_model", "no_eligible_candidates", "insufficient_history", "parent_cart_line_not_found", "empty_cart", "no_candidate_above_threshold"] },
                "model": { "type": "null" },
                "proposals": { "type": "array", "maxItems": 0 }
              }
            },
            {
              "properties": {
                "status": { "const": "paused" },
                "emptyReason": { "const": "recommendation_serving_paused" },
                "model": { "type": "null" },
                "proposals": { "type": "array", "maxItems": 0 }
              }
            }
          ]
        },
        {
          "if": { "type": "object", "properties": { "recommendationType": { "const": "modifier_upsell" } } },
          "then": { "type": "object", "properties": { "proposals": { "type": "array", "maxItems": 3, "items": { "type": "object", "properties": { "action": { "$ref": "#/$defs/ModifierAction" } } } } } },
          "else": { "type": "object", "properties": { "proposals": { "type": "array", "items": { "type": "object", "properties": { "action": { "$ref": "#/$defs/ProductAction" } } } } } }
        }
      ]
    },
    "RenderedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "renderedPosition"],
      "properties": {
        "actionId": { "$ref": "#/$defs/OpaqueId" },
        "renderedPosition": { "type": "integer", "minimum": 1 }
      }
    },
    "ImpressionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "channel",
        "occurredAt",
        "orderingJourneyRef",
        "opportunityRef",
        "cartRevision",
        "renderedActions"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-automatic-recommendation-event-v1" },
        "eventId": { "$ref": "#/$defs/OpaqueId", "description": "Globally unique. Identical event facts replay; changed event facts conflict." },
        "channel": { "enum": ["kiosk", "chat", "workbench", "other"] },
        "occurredAt": { "type": "string", "format": "date-time" },
        "orderingJourneyRef": { "$ref": "#/$defs/OpaqueId" },
        "opportunityRef": { "$ref": "#/$defs/OpaqueId" },
        "cartRevision": { "$ref": "#/$defs/OpaqueId" },
        "renderedActions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/RenderedAction" }
        }
      }
    },
    "OutcomeBase": {
      "type": "object",
      "required": ["schemaVersion", "eventId", "channel", "occurredAt", "orderingJourneyRef", "opportunityRef", "cartRevision"],
      "properties": {
        "schemaVersion": { "const": "kfc-automatic-recommendation-event-v1" },
        "eventId": { "$ref": "#/$defs/OpaqueId", "description": "Globally unique. Identical event facts replay; changed event facts conflict." },
        "channel": { "enum": ["kiosk", "chat", "workbench", "other"] },
        "occurredAt": { "type": "string", "format": "date-time" },
        "orderingJourneyRef": { "$ref": "#/$defs/OpaqueId" },
        "opportunityRef": { "$ref": "#/$defs/OpaqueId" },
        "cartRevision": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "ActionOutcome": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/OutcomeBase" },
        {
          "type": "object",
          "required": ["eventType", "actionId", "renderedPosition"],
          "properties": {
            "eventType": { "enum": ["selected", "action_dismissed"] },
            "actionId": { "$ref": "#/$defs/OpaqueId" },
            "renderedPosition": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "MutationOutcome": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/OutcomeBase" },
        {
          "type": "object",
          "required": ["eventType", "actionId", "cartMutationRef"],
          "properties": {
            "eventType": { "enum": ["cart_mutation_succeeded", "cart_mutation_failed"] },
            "actionId": { "$ref": "#/$defs/OpaqueId" },
            "cartMutationRef": { "$ref": "#/$defs/OpaqueId" }
          }
        }
      ]
    },
    "SlateDismissedOutcome": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/OutcomeBase" },
        {
          "type": "object",
          "required": ["eventType"],
          "properties": { "eventType": { "const": "slate_dismissed" } }
        }
      ]
    },
    "CheckoutCompletedOutcome": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/OutcomeBase" },
        {
          "type": "object",
          "required": ["eventType", "orderRef"],
          "properties": {
            "eventType": { "const": "checkout_completed" },
            "orderRef": { "$ref": "#/$defs/OpaqueId" }
          }
        }
      ]
    },
    "OrderAbandonedOutcome": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/OutcomeBase" },
        {
          "type": "object",
          "required": ["eventType"],
          "properties": { "eventType": { "const": "order_abandoned" } }
        }
      ]
    },
    "OutcomeRequest": {
      "oneOf": [
        { "$ref": "#/$defs/ActionOutcome" },
        { "$ref": "#/$defs/MutationOutcome" },
        { "$ref": "#/$defs/SlateDismissedOutcome" },
        { "$ref": "#/$defs/CheckoutCompletedOutcome" },
        { "$ref": "#/$defs/OrderAbandonedOutcome" }
      ]
    },
    "ProblemDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "status", "code", "retryable"],
      "properties": {
        "type": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": [400, 401, 403, 404, 409, 503] },
        "code": {
          "enum": [
            "invalid_request",
            "unauthorized",
            "forbidden",
            "recommendation_not_found",
            "identity_conflict",
            "stale_or_invalid_action",
            "recommendation_infrastructure_unavailable"
          ]
        },
        "retryable": { "type": "boolean" },
        "requestId": {
          "oneOf": [{ "$ref": "#/$defs/OpaqueId" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "oneOf": [
            { "properties": { "status": { "const": 400 }, "code": { "const": "invalid_request" }, "retryable": { "const": false } } },
            { "properties": { "status": { "const": 401 }, "code": { "const": "unauthorized" }, "retryable": { "const": false } } },
            { "properties": { "status": { "const": 403 }, "code": { "const": "forbidden" }, "retryable": { "const": false } } },
            { "properties": { "status": { "const": 404 }, "code": { "const": "recommendation_not_found" }, "retryable": { "const": false } } },
            { "properties": { "status": { "const": 409 }, "code": { "enum": ["identity_conflict", "stale_or_invalid_action"] }, "retryable": { "const": false } } },
            { "properties": { "status": { "const": 503 }, "code": { "const": "recommendation_infrastructure_unavailable" }, "retryable": { "const": true } } }
          ]
        }
      ]
    },
    "InspectionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recommendationId",
        "requestDigest",
        "cartDigest",
        "model",
        "candidateEvidence",
        "persistenceEvidence"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-automatic-inspection-v1" },
        "recommendationId": { "$ref": "#/$defs/OpaqueId" },
        "requestDigest": { "$ref": "#/$defs/Sha256" },
        "cartDigest": { "$ref": "#/$defs/Sha256" },
        "model": {
          "oneOf": [
            { "$ref": "#/$defs/ModelBinding" },
            { "type": "null" }
          ]
        },
        "candidateEvidence": { "type": "array", "items": { "type": "object" } },
        "persistenceEvidence": { "type": "object" }
      }
    }
  }
}
