{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kfc.invalid/automatic-recommendations/v1/automatic-scorer.schema.json",
  "title": "KFC Automatic Recommendation Scorer Contract",
  "$defs": {
    "OpaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "RecommendationType": {
      "enum": [
        "local_favorite",
        "for_you",
        "modifier_upsell",
        "smart_cross_sell"
      ]
    },
    "ModelBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "bundleDigest",
        "modelRevision",
        "calibratorRevision",
        "featureSchemaDigest",
        "thresholdRevision",
        "composerContractDigest",
        "qualificationRunId",
        "qualificationEvidenceDigest"
      ],
      "properties": {
        "bundleId": { "$ref": "#/$defs/OpaqueId" },
        "bundleDigest": { "$ref": "#/$defs/Sha256" },
        "modelRevision": { "$ref": "#/$defs/OpaqueId" },
        "calibratorRevision": { "$ref": "#/$defs/OpaqueId" },
        "featureSchemaDigest": { "$ref": "#/$defs/Sha256" },
        "thresholdRevision": { "$ref": "#/$defs/OpaqueId" },
        "composerContractDigest": { "$ref": "#/$defs/Sha256" },
        "qualificationRunId": { "$ref": "#/$defs/OpaqueId" },
        "qualificationEvidenceDigest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "eligibility", "priceImpactVnd", "features"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/OpaqueId" },
        "eligibility": { "const": "eligible" },
        "priceImpactVnd": { "type": "integer", "minimum": 0 },
        "features": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string", "boolean", "null"]
          }
        }
      }
    },
    "Score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "selectionProbability",
        "jointProbability",
        "explanationValues"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/OpaqueId" },
        "selectionProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "jointProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "explanationValues": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        }
      }
    },
    "ScorerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "recommendationType",
        "model",
        "candidates"
      ],
      "properties": {
        "schemaVersion": { "const": "kfc-automatic-scorer-v1" },
        "requestId": { "$ref": "#/$defs/OpaqueId" },
        "recommendationType": { "$ref": "#/$defs/RecommendationType" },
        "model": { "$ref": "#/$defs/ModelBinding" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Candidate" }
        }
      }
    },
    "ScorerResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "model", "scores"],
      "properties": {
        "schemaVersion": { "const": "kfc-automatic-scorer-v1" },
        "requestId": { "$ref": "#/$defs/OpaqueId" },
        "model": { "$ref": "#/$defs/ModelBinding" },
        "scores": {
          "type": "array",
          "items": { "$ref": "#/$defs/Score" }
        }
      }
    }
  }
}
