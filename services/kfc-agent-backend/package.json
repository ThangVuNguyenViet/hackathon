{
  "name": "kfc-agent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:studio": "LANGGRAPH_NODE_LOADER=tsx/esm npx @langchain/langgraph-cli@1.4.2 dev --n-jobs-per-worker 1",
    "build": "tsc -p tsconfig.json",
    "check:architecture": "node ../../scripts/check-source-file-size.mjs",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:live:scenarios": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; OPENAI_TOOL_PLANNER_MODEL=${OPENAI_TOOL_PLANNER_MODEL:-gpt-4.1} RUN_LIVE_AI_SCENARIOS=1 vitest run test/scenarios/live-ai-scenario-replay.test.ts --maxConcurrency=1",
    "test:live:small-talk-router": "set -a; [ ! -f ../../.env ] || . ../../.env; [ ! -f ../../../../.env ] || . ../../../../.env; set +a; RUN_LIVE_SMALL_TALK_ROUTER=1 vitest run test/llm/live-small-talk-router.test.ts",
    "test:live:direct-catalog": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; OPENAI_TOOL_PLANNER_MODEL=${OPENAI_TOOL_PLANNER_MODEL:-gpt-4.1} RUN_LIVE_AI_SCENARIOS=1 vitest run test/scenarios/live-ai-direct-catalog.test.ts",
    "test:live:interruption": "set -a; [ ! -f ../../.env ] || . ../../.env; [ ! -f ../../../../.env ] || . ../../../../.env; set +a; OPENAI_TOOL_PLANNER_MODEL=${OPENAI_TOOL_PLANNER_MODEL:-gpt-4.1} OPENAI_RESPONSE_MODEL=${OPENAI_RESPONSE_MODEL:-gpt-4.1-nano} RUN_LIVE_AI_INTERRUPTION=1 vitest run test/worker/live-ai-interruption.test.ts",
    "test:genui:integration": "tsx scripts/run-live-genui-integration-proof.ts",
    "test:live:genui:integration": "tsx scripts/run-live-genui-integration-proof.ts",
    "test:genui:catalog": "node scripts/capture-genui-catalog-artifacts.mjs",
    "proof:commerce:mock": "set -a; [ ! -f ../../.env ] || . ../../.env; [ ! -f ../../../../.env ] || . ../../../../.env; set +a; tsx scripts/run-mock-commerce-proof.ts",
    "sandbox:commerce:serve": "tsx scripts/serve-sandbox-commerce-gateway.ts",
    "proof:langsmith:agentic": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx scripts/run-langsmith-agentic-proof.ts",
    "proof:production:latency": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx scripts/run-production-latency-probe.ts",
    "proof:openai:geo-canary": "tsx scripts/run-openai-geo-canary.ts",
    "proof:live:monitor": "tsx scripts/run-live-monitor-ui-proof.ts",
    "proof:live:messenger": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx scripts/run-live-messenger-proof.ts",
    "trace:langsmith:context-baseline": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; LANGSMITH_TRACING=true tsx scripts/run-langsmith-context-baseline.ts",
    "eval:context": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; LANGSMITH_TRACING=true tsx scripts/run-langsmith-context-eval.ts",
    "eval:context:seed": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx scripts/run-langsmith-context-eval.ts --seed-only",
    "eval:context:experiment": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx scripts/run-langsmith-context-experiment.ts",
    "eval:outcomes": "tsx -- scripts/run-outcome-judgments.ts --env-file ../../.env",
    "eval:genui": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; LANGSMITH_TRACING=true tsx scripts/run-langsmith-genui-eval.ts",
    "eval:genui:seed": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; LANGSMITH_TRACING=true tsx scripts/run-langsmith-genui-eval.ts --seed-only",
    "showcase:seed": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx scripts/seed-showcase.ts",
    "proof:genui:consolidate": "tsx scripts/consolidate-genui-proof.ts",
    "test:watch": "vitest",
    "fixtures:build": "tsx scripts/build-fixtures.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:dry-run": "wrangler deploy --dry-run",
    "worker:queue:create": "wrangler queues create kfc-messenger-webhook-jobs && wrangler queues create kfc-messenger-webhook-dlq",
    "worker:preflight": "tsx scripts/demo-preflight.ts",
    "demo:human-loop": "tsx scripts/demo-human-loop.ts",
    "worker:d1:migrate:local": "wrangler d1 migrations apply kfc-agent-demo --local",
    "worker:d1:migrate:remote": "wrangler d1 migrations apply ${KFC_D1_DATABASE_NAME:-kfc-agent-demo} --remote"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.4.7",
    "fastify": "^5.4.0",
    "gray-matter": "^4.0.3",
    "langsmith": "^0.3.39",
    "pg": "^8.16.3",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.4",
    "playwright-core": "^1.55.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.108.0"
  },
  "engines": {
    "node": ">=22"
  }
}
