{
  "name": "kfc-agent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:studio": "LANGGRAPH_NODE_LOADER=tsx/esm npx @langchain/langgraph-cli@1.4.2 dev --n-jobs-per-worker 1",
    "clean:dist": "node scripts/clean-dist.mjs",
    "build": "npm run clean:dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "node scripts/run-format-gate.mjs --write",
    "format:check": "node scripts/run-format-gate.mjs --check",
    "lint": "eslint .",
    "lint:strict": "node scripts/check-eslint-warning-budget.mjs",
    "test:ci": "vitest run",
    "check": "npm run format:check && npm run lint && npm run lint:strict && npm run typecheck && npm run test:ci",
    "check:architecture": "node ../../scripts/check-source-file-size.mjs",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:live:scenarios": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; RUN_LIVE_AI_SCENARIOS=1 vitest run test/scenarios/live-ai-scenario-replay.test.ts",
    "test:live:direct-agents-sdk": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; RUN_LIVE_DIRECT_AGENT_SCENARIOS=1 tsx scripts/run-direct-agent-live-scenarios.ts",
    "test:live:scenarios:high-risk": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; KFC_LIVE_SCENARIO_MODE=text KFC_LIVE_HIGH_RISK_REPETITIONS=3 RUN_LIVE_AI_SCENARIOS=1 vitest run test/scenarios/live-ai-scenario-replay.test.ts",
    "test:live:qualification:text": "node scripts/run-live-text-qualification.mjs",
    "test:live:interruption": "set -a; [ ! -f ../../.env ] || . ../../.env; [ ! -f ../../../../.env ] || . ../../../../.env; set +a; KFC_AGENT_PROVIDER=openai KFC_AGENT_MODEL=gpt-4.1-mini RUN_LIVE_AI_INTERRUPTION=1 vitest run test/worker/live-ai-interruption.test.ts",
    "test:genui:integration": "tsx scripts/run-live-genui-integration-proof.ts",
    "test:live:genui:integration": "tsx scripts/run-live-genui-integration-proof.ts",
    "test:genui:catalog": "node scripts/capture-genui-catalog-artifacts.mjs",
    "sandbox:commerce:serve": "tsx scripts/serve-sandbox-commerce-gateway.ts",
    "proof:production:latency": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx scripts/run-production-latency-probe.ts",
    "proof:openai:geo-canary": "tsx scripts/run-openai-geo-canary.ts",
    "proof:live:monitor": "tsx scripts/run-live-monitor-ui-proof.ts",
    "proof:live:messenger": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx scripts/run-live-messenger-proof.ts",
    "eval:live-quality:sync": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx scripts/sync-langsmith-live-quality-dataset.ts",
    "eval:outcomes": "tsx -- scripts/run-outcome-judgments.ts --env-file ../../.env",
    "eval:genui": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; LANGSMITH_TRACING=true tsx scripts/run-langsmith-genui-eval.ts",
    "eval:genui:seed": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; LANGSMITH_TRACING=true tsx scripts/run-langsmith-genui-eval.ts --seed-only",
    "showcase:seed": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx scripts/seed-showcase.ts",
    "proof:genui:consolidate": "tsx scripts/consolidate-genui-proof.ts",
    "test:watch": "vitest",
    "fixtures:build": "tsx scripts/build-fixtures.ts",
    "policies:build": "tsx scripts/build-policy-fixtures.ts",
    "policies:check": "tsx scripts/build-policy-fixtures.ts --check",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:dry-run": "wrangler deploy --dry-run",
    "worker:queue:create": "wrangler queues create kfc-messenger-webhook-jobs && wrangler queues create kfc-messenger-webhook-dlq",
    "worker:preflight": "tsx scripts/demo-preflight.ts",
    "worker:d1:migrate:local": "wrangler d1 migrations apply kfc-agent-demo --local",
    "worker:d1:migrate:remote": "wrangler d1 migrations apply ${KFC_D1_DATABASE_NAME:-kfc-agent-demo} --remote"
  },
  "dependencies": {
    "@langchain/core": "1.2.3",
    "@langchain/google": "0.2.1",
    "@langchain/langgraph": "1.4.8",
    "@langchain/openai": "1.5.5",
    "@kfc/openai-agents-runtime": "file:packages/openai-agents-runtime",
    "fastify": "^5.4.0",
    "gray-matter": "^4.0.3",
    "langchain": "1.5.3",
    "langsmith": "0.8.3",
    "openai": "6.49.0",
    "pg": "^8.16.3",
    "tsx": "^4.20.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.4",
    "eslint": "^10.7.0",
    "playwright-core": "^1.55.0",
    "prettier": "3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.108.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
