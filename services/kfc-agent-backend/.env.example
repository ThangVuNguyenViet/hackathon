PORT=18090
DATABASE_URL=postgres://kfc_agent:kfc_agent@localhost:15432/kfc_agent
OPENAI_API_KEY=
GOOGLE_API_KEY=
KFC_AGENT_PROFILE_MODE=production
KFC_AGENT_PROVIDER=google
KFC_AGENT_RUNTIME=stategraph
# Optional fail-closed assertion; omit to use the repository profile's pinned model.
KFC_AGENT_MODEL=gemini-3.1-flash-lite
# Direct OpenAI Agents SDK runtime only. Compaction rewrites model context;
# customer-visible turns and verified commerce state remain separate.
KFC_AGENT_COMPACTION_ENABLED=true
KFC_AGENT_COMPACTION_THRESHOLD_BYTES=98304
KFC_AGENT_COMPACTION_MODEL=
# Qualification uses the same affordable model IDs with deeper Google thinking.
# KFC_AGENT_PROFILE_MODE=qualification
# The asynchronous, non-authoritative monitor follows KFC_AGENT_PROVIDER by
# default. Set both only to make an explicit pinned-provider assertion.
# KFC_MONITOR_PROVIDER=google
# KFC_MONITOR_MODEL=gemini-3.1-flash-lite
# Server-only HMAC authority for one-shot approval capabilities, receipts, and
# operation fences. Use at least 32 random bytes and keep prior keys only
# during a bounded rotation window.
KFC_CONFIRMATION_SIGNING_KEY_ID=primary
KFC_CONFIRMATION_SIGNING_SECRET=
KFC_CONFIRMATION_PREVIOUS_SIGNING_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENCODE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kfc-agent-backend-local
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_TRACING_SAMPLING_RATE=1
KFC_DEMO_ADMIN_TOKEN=
MESSENGER_VERIFY_TOKEN=
META_PAGE_ID=118976205445198
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_INBOX_URL_TEMPLATE=https://business.facebook.com/latest/inbox/all?asset_id={pageId}&selected_item_id={externalUserId}
MESSENGER_GRAPH_API_BASE_URL=
ZALO_OA_ID=
ZALO_ACCESS_TOKEN=
ZALO_INBOX_URL_TEMPLATE=https://oa.zalo.me/chatv2?oaid={pageId}&uid={externalUserId}
ZALO_REFRESH_TOKEN=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_API_BASE_URL=
KFC_COMMERCE_MODE=gateway
KFC_COMMERCE_ENVIRONMENT=sandbox
KFC_MENU_API_URL=https://api.kfcvietnam.com.vn/menu/kfcvn-generic-menu
CATALOG_TTL_SECONDS=300
KFC_COMMERCE_GATEWAY_BASE_URL=https://commerce.example.test
KFC_COMMERCE_GATEWAY_TOKEN=replace-me
KFC_POS_MODE=disabled
KFC_POS_BASE_URL=
KFC_POS_TOKEN=
