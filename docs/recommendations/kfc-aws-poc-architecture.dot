digraph KFCRecommendationArchitecture {
  graph [
    rankdir=TB,
    newrank=true,
    compound=true,
    splines=ortho,
    bgcolor="transparent",
    pad=0.18,
    nodesep=0.52,
    ranksep=0.58,
    fontname="Arial",
    fontsize=18
  ];

  node [shape=plain, fontname="Arial", fontsize=16];
  edge [fontname="Arial", fontsize=11, color="#59636E", fontcolor="#59636E", penwidth=1.8, arrowsize=0.72];

  channels [label=<
    <TABLE BORDER="1" COLOR="#232F3E" BGCOLOR="#232F3E" CELLBORDER="0" CELLPADDING="5" STYLE="ROUNDED">
      <TR><TD><IMG SRC="docs/recommendations/assets/aws-icons/users.png" SCALE="TRUE"/></TD></TR>
      <TR><TD><FONT COLOR="white"><B>KFC channels</B></FONT></TD></TR>
      <TR><TD><FONT COLOR="white" POINT-SIZE="11">Kiosk · Web</FONT></TD></TR>
      <TR><TD><FONT COLOR="white" POINT-SIZE="11">App · Zalo</FONT></TD></TR>
    </TABLE>
  >];

  poc_data [label=<
    <TABLE BORDER="1" COLOR="#59636E" BGCOLOR="#F7F8FA" CELLBORDER="0" CELLPADDING="6" STYLE="ROUNDED">
      <TR><TD><B>KFC-approved</B></TD></TR>
      <TR><TD><B>POC data</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="11">Orders · interactions · catalog</FONT></TD></TR>
    </TABLE>
  >];

  subgraph cluster_aws {
    label=<<B>AWS Cloud — KFC recommendation POC</B>>;
    labelloc="t";
    labeljust="l";
    color="#7D8998";
    bgcolor="#FAFBFC";
    penwidth=1.5;
    style="rounded";
    margin=18;

    api_orchestration [label=<
      <TABLE BORDER="1" COLOR="#ED7100" BGCOLOR="white" CELLBORDER="0" CELLPADDING="6" STYLE="ROUNDED">
        <TR>
          <TD><IMG SRC="docs/recommendations/assets/aws-icons/api-gateway.png" SCALE="TRUE"/></TD>
          <TD><IMG SRC="docs/recommendations/assets/aws-icons/lambda.png" SCALE="TRUE"/></TD>
        </TR>
        <TR><TD COLSPAN="2"><B>API &amp; orchestration</B></TD></TR>
        <TR><TD COLSPAN="2"><FONT POINT-SIZE="11">API Gateway · Lambda</FONT></TD></TR>
        <TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#59636E">Managed API · business rules</FONT></TD></TR>
      </TABLE>
    >];

    recommendation_engine [label=<
      <TABLE BORDER="1" COLOR="#01A88D" BGCOLOR="white" CELLBORDER="0" CELLPADDING="6" STYLE="ROUNDED">
        <TR>
          <TD><IMG SRC="docs/recommendations/assets/aws-icons/personalize.png" SCALE="TRUE"/></TD>
          <TD><IMG SRC="docs/recommendations/assets/aws-icons/sagemaker.png" SCALE="TRUE"/></TD>
        </TR>
        <TR><TD COLSPAN="2"><B>Recommendation intelligence</B></TD></TR>
        <TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Personalize · SageMaker AI</FONT></TD></TR>
        <TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#59636E">Relevance + final business ranking</FONT></TD></TR>
      </TABLE>
    >];

    data_foundation [label=<
      <TABLE BORDER="1" COLOR="#7AA116" BGCOLOR="#F7FAF1" CELLBORDER="0" CELLPADDING="6" STYLE="ROUNDED">
        <TR>
          <TD><IMG SRC="docs/recommendations/assets/aws-icons/s3.png" SCALE="TRUE"/></TD>
          <TD><IMG SRC="docs/recommendations/assets/aws-icons/athena.png" SCALE="TRUE"/></TD>
          <TD><IMG SRC="docs/recommendations/assets/aws-icons/dynamodb.png" SCALE="TRUE"/></TD>
        </TR>
        <TR><TD COLSPAN="3"><B>POC data foundation</B></TD></TR>
        <TR><TD COLSPAN="3"><FONT POINT-SIZE="11">S3 · Athena · DynamoDB</FONT></TD></TR>
        <TR><TD COLSPAN="3"><FONT POINT-SIZE="10" COLOR="#59636E">Curated history + current menu context</FONT></TD></TR>
      </TABLE>
    >];

    support [label=<
      <TABLE BORDER="0" BGCOLOR="#F4F5F7" CELLBORDER="0" CELLPADDING="5" STYLE="ROUNDED">
        <TR>
          <TD><IMG SRC="docs/recommendations/assets/aws-icons/secrets-manager.png" SCALE="TRUE"/></TD>
          <TD><IMG SRC="docs/recommendations/assets/aws-icons/cloudwatch.png" SCALE="TRUE"/></TD>
          <TD><IMG SRC="docs/recommendations/assets/aws-icons/ecr.png" SCALE="TRUE"/></TD>
        </TR>
        <TR><TD COLSPAN="3"><B>Supporting services</B></TD></TR>
        <TR><TD COLSPAN="3"><FONT POINT-SIZE="10" COLOR="#59636E">Secrets Manager · CloudWatch · ECR</FONT></TD></TR>
      </TABLE>
    >];

    { rank=same; api_orchestration; recommendation_engine; }
    { rank=same; data_foundation; support; }

    api_orchestration -> recommendation_engine [
      dir=both,
      arrowtail=normal,
      color="#E4002B",
      penwidth=2.7
    ];

    data_foundation -> api_orchestration [
      color="#7AA116",
      constraint=false
    ];

    data_foundation -> recommendation_engine [
      color="#7AA116",
      constraint=false
    ];

    data_foundation -> support [style=invis, weight=18];
  }

  { rank=same; channels; api_orchestration; recommendation_engine; }
  { rank=same; poc_data; data_foundation; support; }

  channels -> api_orchestration [
    dir=both,
    arrowtail=normal,
    color="#E4002B",
    penwidth=2.8
  ];

  poc_data -> data_foundation [
    color="#7AA116",
    penwidth=2.2
  ];

  channels -> poc_data [style=invis, weight=22];
}
